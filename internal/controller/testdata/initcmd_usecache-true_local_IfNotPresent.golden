cache_fs=$(stat -f -c %t "$CACHE_DIR" 2>/dev/null || stat -f -c %t "$(dirname "$CACHE_DIR")") || { echo "WARNING: cannot determine the cache filesystem: this init image's stat has no -f; staging under the directory lock, which does not exclude pods on other nodes on a FUSE cache" >&2; cache_fs=unknown; }; llmkube_fuse_reader() { [ "$cache_fs" = 65735546 ] && [ "${LLMKUBE_PREFETCH_STAGER:-false}" != true ]; }; llmkube_stage_allowed() { if llmkube_fuse_reader; then echo "ERROR: ModelCacheLockUnsupported: FUSE cache cannot guarantee cross-node file locking for staging $1; local sources do not support prefetch; use storage with cross-node flock support, or pre-stage the file and use a pvc:// source" >&2; return 1; fi; }; if [ "$cache_fs" != 65735546 ]; then mkdir -p "$CACHE_DIR" || exit 1; if [ -w "$CACHE_DIR" ]; then command -v flock >/dev/null 2>&1 || { echo "ERROR: the init image must provide flock to lock $CACHE_DIR" >&2; exit 1; }; command exec 9>"$CACHE_DIR/.llmkube-download.lock" || { echo "ERROR: could not open $CACHE_DIR/.llmkube-download.lock" >&2; exit 1; }; if ! flock -n 9; then echo 'Waiting for the download lock held by another pod...'; flock 9 || { echo "ERROR: could not lock $CACHE_DIR/.llmkube-download.lock; the cache volume must support file locking (NFS needs a lock daemon)" >&2; exit 1; }; fi; else echo "WARNING: $CACHE_DIR is not writable by uid $(id -u); skipping the download lock" >&2; fi; find "$CACHE_DIR" -type f \( -name '*.llmkube-tmp.??????' -o -name '*.llmkube-size.??????' -o -name '*.sha256-rejected.??????' \) -mmin +10 -delete 2>/dev/null; elif [ "${LLMKUBE_PREFETCH_STAGER:-false}" = true ]; then mkdir -p "$CACHE_DIR" || exit 1; find "$CACHE_DIR" -type f \( -name '*.llmkube-tmp.??????' -o -name '*.llmkube-size.??????' -o -name '*.sha256-rejected.??????' \) -mmin +10 -delete 2>/dev/null; fi; { llmkube_fuse_reader || rm -f "$MODEL_PATH.tmp"; } && if [ ! -f "$MODEL_PATH" ]; then llmkube_stage_allowed "${MODEL_PATH##*/}" || exit 1; echo 'Copying model from local source...'; cp /host-model/model.gguf "$MODEL_PATH.tmp" && mv "$MODEL_PATH.tmp" "$MODEL_PATH" && echo 'Model copied successfully'; else echo 'Model already cached, skipping copy'; fi